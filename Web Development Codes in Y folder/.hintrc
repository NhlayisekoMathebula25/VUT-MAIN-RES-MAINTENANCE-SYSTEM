{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": "off",
    "no-inline-styles": "off",
    "meta-viewport": "off",
    "axe/forms": "off",
    "css-prefix-order": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not ios_saf <= 26",
    "not safari <= 26.1",
    "not and_ff <= 144",
    "not firefox <= 144"
  ]
}